# DSL Stationery E-Commerce Environment Configuration

# Next.js Application Port
PORT=3000

# API Backend Configuration
# Toggle between local in-memory/localStorage mock layer (true) and real backend API (false)
NEXT_PUBLIC_USE_MOCK=true

# Remote Backend API Base URL (when NEXT_PUBLIC_USE_MOCK=false)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Currency & Localization Defaults
NEXT_PUBLIC_DEFAULT_CURRENCY=LKR
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD_CENTS=500000

# Demo Mode Settings
NEXT_PUBLIC_ENABLE_DEMO_BANNER=true
