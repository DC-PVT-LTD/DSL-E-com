# ==============================================================================
# DSL Stationery E-Commerce Platform — Backend Environment Configuration
# ==============================================================================
# Copy this file to '.env' in the backend directory for local development and QA.
# NEVER commit the real '.env' file containing real secrets to version control.

# Application Server
PORT=4000
NODE_ENV=development

# Allowed CORS Origins (comma-separated list for Next.js storefront and admin portal)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# PostgreSQL Database Connection URL (Prisma 7 with @prisma/adapter-pg)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/dsl_stationery?schema=public

# Dedicated Database for Integration / E2E Tests (Optional for local QA)
TEST_DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/dsl_stationery_test?schema=public

# JWT Authentication & Admin Session Security
# Generate a random 64-character hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_64_character_hex_jwt_secret_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
BCRYPT_ROUNDS=10

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000/api/v1

# Local File Storage Directory (for private bank transfer deposit slips)
STORAGE_DIR=uploads/private_receipts

# Primary Super Admin Account (Protected from deletion or privilege demotion)
PRIMARY_SUPER_ADMIN_EMAIL=admin@dslstationery.lk

# Optional: Initial Admin Seed Provisioning
PROVISION_ADMIN_EMAIL=admin@dslstationery.lk
PROVISION_ADMIN_PASSWORD=your_initial_admin_password_here

# PayHere Payment Gateway (Card Payments)
# For local testing, obtain Sandbox Merchant ID and Secret from sandbox.payhere.lk
PAYHERE_MERCHANT_ID=your_payhere_merchant_id_here
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret_here
PAYHERE_SANDBOX=true
PAYHERE_NOTIFY_URL=http://localhost:4000/api/v1/payments/payhere/notify

# Transactional Email / SMTP Configuration (Optional in local development; logs to console if omitted)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
MAIL_FROM_NAME="DSL Stationery"
MAIL_FROM_EMAIL=no-reply@dslstationery.lk
CONTACT_RECEIVER_EMAIL=support@dslstationery.lk

# OCR / Vision Service Configuration (Upload Your List feature)
# Options: 'auto' (default) | 'simulated' | 'google_vision'
OCR_PROVIDER=auto
OCR_API_KEY=your_google_cloud_vision_or_gemini_api_key_here
OCR_MAX_RETRIES=3
OCR_TIMEOUT_MS=15000
