# Application Configuration
PORT=4000
NODE_ENV=development

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Database Configuration (Placeholder - configure in local .env during Phase 4 Step 2)
DATABASE_URL=postgresql://user:password@localhost:5432/dsl_stationery?schema=public

# OCR / Vision Provider Configuration (Phase 14)
# Options: 'google_vision' | 'gemini_vision' | 'simulated' | 'auto' (default: auto)
OCR_PROVIDER=auto
# API key for Google Cloud Vision or Google Gemini Vision
OCR_API_KEY=your_google_cloud_vision_or_gemini_api_key_here
OCR_MAX_RETRIES=3
OCR_TIMEOUT_MS=15000

# Email / SMTP Provider Configuration (Phase 15.6 - Optional for production delivery)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# EMAIL_PROVIDER_API_KEY=your_email_provider_api_key_here
# NEWSLETTER_VERIFICATION_EXPIRY_HOURS=24

