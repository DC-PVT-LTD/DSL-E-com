// ==============================================================================
// DSL Stationery E-Commerce — Production Database Schema
// Engine: PostgreSQL 18.4 (dsl_stationery)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BANK_TRANSFER
  CARD_PAYHERE
  KOKO_BNPL
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
  PRODUCT_SPECIFIC
  CATEGORY_SPECIFIC
  ORDER_LEVEL
}

enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  EXPIRED
  DISABLED
}

enum InventoryChangeReason {
  RESTOCK
  CORRECTION
  DAMAGED
  ORDER_FULFILLMENT
  DEMO_RESET
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  READY_FOR_CONFIRMATION
  CONFIRMED
  FAILED
  PROCESSED
  REVIEWED
  CONVERTED_TO_CART
}

enum ItemConfidence {
  HIGH
  MEDIUM
  LOW
}

enum BackInStockAlertStatus {
  PENDING
  PROCESSING
  SENT
  CANCELLED
}

enum MatchStatus {
  MATCHED
  UNMATCHED
  CUSTOM_SELECTED
  SKIPPED
  CONFIRMED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  RELEASED
  PAYMENT_PENDING
}

enum PaymentAttemptStatus {
  INITIATED
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum BannerStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// ------------------------------------------------------------------------------
// USERS & ADDRESSES
// ------------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  name         String
  role         UserRole @default(CUSTOMER)
  roleId       String?
  assignedRole Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Brute-force protection
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Password reset (stores only a SHA-256 hash — never the raw token)
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  // Email verification (Phase B.1 — stores only a SHA-256 hash of OTP)
  isEmailVerified             Boolean   @default(false)
  emailVerificationOtpHash    String?
  emailVerificationExpiresAt  DateTime?
  emailVerificationAttempts   Int       @default(0)
  emailVerificationLastSentAt DateTime?

  addresses            Address[]
  orders               Order[]
  wishlist             WishlistItem[]
  savedLists           SavedList[]
  savedStationeryLists SavedStationeryList[]
  documents            UploadedDocument[]
  auditLogs            AuditLog[]
  refreshTokens        RefreshToken[]
  cart                 Cart?
  reservations         StockReservation[]
  backInStockAlerts    BackInStockAlert[]
  createdBanners       HomepageBanner[]       @relation("BannerCreatedBy")
  updatedBanners       HomepageBanner[]       @relation("BannerUpdatedBy")
  promotionRedemptions PromotionRedemption[]
  invitationsSent      AdminInvitation[]      @relation("InvitedAdmins")
  importPreviews       ProductImportPreview[] @relation("ImportPreviewsCreated")
  importBatches        ProductImportBatch[]   @relation("ImportBatchesCreated")

  @@index([email])
  @@index([phone])
  @@index([roleId])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  email        String
  addressLine1 String
  addressLine2 String?
  city         String
  district     String // One of 25 Sri Lanka districts
  postalCode   String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([district])
}

// ------------------------------------------------------------------------------
// REFRESH TOKENS (Authentication Sessions)
// ------------------------------------------------------------------------------

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // SHA-256 of the raw refresh token — raw token is NEVER stored
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Note: @unique on tokenHash already creates a B-tree unique index.
  // A redundant @@index([tokenHash]) is intentionally omitted.

  @@index([userId])
  @@index([expiresAt])
}

// ------------------------------------------------------------------------------
// CATALOG (CATEGORIES, BRANDS, PRODUCTS & VARIANTS)
// ------------------------------------------------------------------------------

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String
  iconName     String?
  image        String?
  featured     Boolean    @default(false)
  displayOrder Int        @default(0)
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[] @relation("CategoryHierarchy")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  products    Product[]           @relation("ProductCategory")
  subProducts Product[]           @relation("ProductSubcategory")
  promotions  PromotionCategory[]

  @@index([slug])
  @@index([featured])
  @@index([parentId])
}

model Brand {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String
  logo          String?
  originCountry String
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]

  @@index([slug])
}

model Product {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  sku                 String    @unique
  barcode             String?   @unique
  description         String
  shortDescription    String
  categoryId          String
  category            Category  @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId       String?
  subcategory         Category? @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  brandId             String
  brand               Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  priceCents          Int // Price in integer cents (e.g. 45000 = Rs. 450.00)
  compareAtPriceCents Int?
  costPriceCents      Int?
  stockQuantity       Int       @default(0)
  lowStockThreshold   Int       @default(5)
  isActive            Boolean   @default(true)
  isFeatured          Boolean   @default(false)
  isNewArrival        Boolean   @default(false)
  isBestSeller        Boolean   @default(false)
  images              String[]  @default([])
  tags                String[]  @default([]) // Keywords including Sinhala/Tamil
  rating              Float     @default(5.0)
  reviewCount         Int       @default(0)
  specifications      Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  variants           ProductVariant[]
  globalSku          GlobalSku?
  movements          InventoryMovement[]
  orderItems         OrderItem[]
  packItems          SchoolPackItem[]
  matchedUploadItems ExtractedStationeryItem[]
  wishlistItems      WishlistItem[]
  savedListItems     SavedListItem[]
  cartItems          CartItem[]
  reservationItems   StockReservationItem[]
  backInStockAlerts  BackInStockAlert[]
  promotions         PromotionProduct[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([priceCents])
}

model ProductVariant {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                String // e.g. "Blue Ink / Single Line"
  sku                 String   @unique
  priceCents          Int
  compareAtPriceCents Int?
  stockQuantity       Int      @default(0)
  attributes          Json // { "color": "Blue", "ruling": "Single Line" }
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  orderItems       OrderItem[]
  globalSku        GlobalSku?
  movements        InventoryMovement[]
  cartItems        CartItem[]
  reservationItems StockReservationItem[]

  @@index([productId])
  @@index([sku])
}

model InventoryMovement {
  id               String                @id @default(cuid())
  productId        String
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  previousQuantity Int
  newQuantity      Int
  changeAmount     Int
  reason           InventoryChangeReason
  note             String?
  performedById    String?
  createdAt        DateTime              @default(now())

  @@index([productId])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// SCHOOL PACKS & BUNDLES
// ------------------------------------------------------------------------------

model SchoolPack {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  grade             String // e.g. "Grade 1-2", "Grade 6-9", "O/L"
  tier              String // "essential", "standard", "premium"
  description       String
  savingsPercentage Int      @default(10)
  totalPriceCents   Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items SchoolPackItem[]

  @@index([slug])
  @@index([grade])
}

model SchoolPackItem {
  id                   String     @id @default(cuid())
  packId               String
  pack                 SchoolPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  productId            String
  product              Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  defaultQuantity      Int        @default(1)
  unitPriceCents       Int
  substituteProductIds String[]   @default([])
  createdAt            DateTime   @default(now())

  @@index([packId])
  @@index([productId])
}

// ------------------------------------------------------------------------------
// ORDERS & IMMUTABLE SNAPSHOTS
// ------------------------------------------------------------------------------

model Order {
  id                    String                @id @default(cuid())
  orderNumber           String                @unique // e.g. "DSL-2026-4891"
  userId                String?
  user                  User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName          String
  customerEmail         String
  customerPhone         String
  subtotalCents         Int
  discountCents         Int                   @default(0)
  deliveryCents         Int                   @default(0)
  totalCents            Int
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus         @default(PENDING)
  orderStatus           OrderStatus           @default(PENDING)
  notes                 String?
  trackingNumber        String?
  estimatedDeliveryDate DateTime?
  promotionId           String?
  promotion             Promotion?            @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promoCode             String?
  promotionRedemptions  PromotionRedemption[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  addressSnapshot OrderAddressSnapshot?
  items           OrderItem[]
  reservation     StockReservation?
  paymentAttempts PaymentAttempt[]
  auditLogs       OrderAuditLog[]
  orderNotes      OrderNote[]
  returnRequests  OrderReturnRequest[]
  refundRecords   RefundRecord[]

  // Guest order tracking security (Phase B.1 — stores only a SHA-256 hash of OTP)
  trackingOtpHash       String?
  trackingOtpExpiresAt  DateTime?
  trackingOtpAttempts   Int       @default(0)
  trackingOtpLastSentAt DateTime?

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([orderStatus])
  @@index([createdAt])
}

model OrderAddressSnapshot {
  id               String  @id @default(cuid())
  orderId          String  @unique
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fullName         String
  phone            String
  email            String
  addressLine1     String
  addressLine2     String?
  city             String
  district         String // One of 25 Sri Lanka districts
  postalCode       String?
  province         String?
  buildingNo       String?
  street           String?
  landmark         String?
  formattedAddress String?
  latitude         Float?
  longitude        Float?
  deliveryNotes    String?
}

model OrderItem {
  id              String            @id @default(cuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId       String?
  variant         ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName     String // Frozen name snapshot
  variantName     String? // Frozen variant name snapshot
  sku             String // Frozen SKU snapshot
  unitPriceCents  Int // Frozen price snapshot at purchase time
  quantity        Int
  totalPriceCents Int // unitPriceCents * quantity
  createdAt       DateTime          @default(now())
  returnItems     OrderReturnItem[]

  @@index([orderId])
  @@index([productId])
}

// ------------------------------------------------------------------------------
// ORDER MANAGEMENT: AUDIT, NOTES, RETURNS & REFUNDS
// ------------------------------------------------------------------------------

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ReturnItemStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model OrderAuditLog {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminId       String?
  adminName     String   @default("System")
  action        String // "STATUS_CHANGE", "CUSTOMER_UPDATE", "DELIVERY_UPDATE", "ITEMS_UPDATE", "ORDER_CANCELLED", "RETURN_DECISION", "REFUND_RECORDED", "NOTE_ADDED"
  fieldChanged  String?
  previousValue String?
  newValue      String?
  reason        String?
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model OrderNote {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String   @default("Staff")
  note       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model OrderReturnRequest {
  id              String            @id @default(cuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnNumber    String            @unique
  status          ReturnStatus      @default(PENDING)
  reason          String
  rejectionReason String?
  items           OrderReturnItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([orderId])
}

model OrderReturnItem {
  id              String             @id @default(cuid())
  returnRequestId String
  returnRequest   OrderReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productName     String
  quantity        Int
  reason          String
  status          ReturnItemStatus   @default(PENDING)
  rejectionReason String?
  receivedAt      DateTime?
  createdAt       DateTime           @default(now())

  @@index([returnRequestId])
  @@index([orderItemId])
}

model RefundRecord {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents Int
  method      String // e.g. "MANUAL_BANK_TRANSFER", "PAYHERE_OFFLINE", "STORE_CREDIT"
  reference   String?
  reason      String
  processedBy String? // Admin ID/name
  createdAt   DateTime @default(now())

  @@index([orderId])
}

// ------------------------------------------------------------------------------
// STOCK RESERVATIONS & PAYMENT ATTEMPTS
// ------------------------------------------------------------------------------

model StockReservation {
  id             String            @id @default(cuid())
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId      String? // Anonymous guest checkout session
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime
  idempotencyKey String?           @unique
  orderId        String?           @unique
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  items           StockReservationItem[]
  paymentAttempts PaymentAttempt[]

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([expiresAt])
}

model StockReservationItem {
  id             String           @id @default(cuid())
  reservationId  String
  reservation    StockReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int
  unitPriceCents Int
  createdAt      DateTime         @default(now())

  @@index([reservationId])
  @@index([productId])
  @@index([variantId])
}

model PaymentAttempt {
  id               String               @id @default(cuid())
  reservationId    String
  reservation      StockReservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amountCents      Int
  currency         String               @default("LKR")
  paymentMethod    PaymentMethod
  status           PaymentAttemptStatus @default(INITIATED)
  gatewayReference String?              @unique
  idempotencyKey   String?              @unique
  gatewayPayload   Json?
  failureReason    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([reservationId])
  @@index([orderId])
  @@index([status])
}

// ------------------------------------------------------------------------------
// PROMOTIONS & VOUCHERS
// ------------------------------------------------------------------------------

model Promotion {
  id                         String          @id @default(cuid())
  name                       String          @default("")
  title                      String?
  code                       String?         @unique
  description                String?
  promotionType              PromotionType   @default(PERCENTAGE)
  discountType               DiscountType    @default(PERCENTAGE)
  discountValue              Int // Percentage (e.g. 10) or Fixed Rupees/Cents
  maximumDiscountAmount      Int? // Maximum cap in cents
  maxDiscountCents           Int? // Legacy alias in cents
  minimumOrderAmount         Int? // Minimum order in cents
  minOrderAmountCents        Int? // Legacy alias in cents
  status                     PromotionStatus @default(ACTIVE)
  startDate                  DateTime
  endDate                    DateTime
  priority                   Int             @default(0)
  isStackableWithSchoolPacks Boolean         @default(false)
  isActive                   Boolean         @default(true)
  usageLimit                 Int?
  usageCount                 Int             @default(0)
  createdBy                  String?
  updatedBy                  String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  codes              PromotionCode[]
  eligibleProducts   PromotionProduct[]
  eligibleCategories PromotionCategory[]
  redemptions        PromotionRedemption[]
  orders             Order[]

  @@index([code])
  @@index([isActive])
  @@index([status])
  @@index([startDate, endDate])
}

model PromotionCode {
  id                      String    @id @default(cuid())
  promotionId             String
  promotion               Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  code                    String    @unique
  isActive                Boolean   @default(true)
  maximumTotalUsage       Int?
  maximumUsagePerCustomer Int?
  totalUsage              Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  redemptions PromotionRedemption[]

  @@index([promotionId])
  @@index([code])
}

model PromotionProduct {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([promotionId, productId])
  @@index([promotionId])
  @@index([productId])
}

model PromotionCategory {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([promotionId, categoryId])
  @@index([promotionId])
  @@index([categoryId])
}

model PromotionRedemption {
  id              String         @id @default(cuid())
  promotionId     String
  promotion       Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionCodeId String?
  promotionCode   PromotionCode? @relation(fields: [promotionCodeId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        User?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerEmail   String?
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  discountAmount  Int // in cents
  redeemedAt      DateTime       @default(now())

  @@unique([orderId, promotionId])
  @@index([promotionId])
  @@index([promotionCodeId])
  @@index([customerId])
  @@index([customerEmail])
  @@index([orderId])
}

// ------------------------------------------------------------------------------
// UPLOADED BOOKLIST DOCUMENTS & OCR EXTRACTIONS
// ------------------------------------------------------------------------------

model UploadedDocument {
  id              String         @id @default(cuid())
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId       String?
  fileName        String
  fileUrl         String
  storagePath     String?
  fileSizeBytes   Int
  fileType        String
  pageCount       Int            @default(1)
  status          DocumentStatus @default(UPLOADED)
  isSimulatedOCR  Boolean        @default(false)
  ocrProvider     String?
  customerNotes   String?
  processingError String?
  attempts        Int            @default(0)
  processedAt     DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  extractedItems ExtractedStationeryItem[]

  @@index([userId])
  @@index([sessionId])
  @@index([status])
}

model ExtractedStationeryItem {
  id                   String           @id @default(cuid())
  documentId           String
  document             UploadedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  rawText              String
  itemDescription      String
  quantity             Int              @default(1)
  unit                 String?
  confidence           ItemConfidence   @default(MEDIUM)
  confidenceScore      Float            @default(0.8)
  extractionConfidence Float            @default(0.8)
  matchConfidence      Float            @default(0.8)
  matchReason          String?
  matchedProductId     String?
  matchedProduct       Product?         @relation(fields: [matchedProductId], references: [id], onDelete: SetNull)
  matchedVariantId     String?
  candidateProductIds  String[]         @default([])
  status               MatchStatus      @default(MATCHED)
  isConfirmed          Boolean          @default(false)
  confirmedProductId   String?
  confirmedVariantId   String?
  confirmedQuantity    Int?
  isSubstituted        Boolean          @default(false)
  createdAt            DateTime         @default(now())

  @@index([documentId])
  @@index([matchedProductId])
}

// ------------------------------------------------------------------------------
// WISHLIST & SAVED LISTS
// ------------------------------------------------------------------------------

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model SavedStationeryList {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  itemProductIds String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model SavedList {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     SavedListItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
}

model SavedListItem {
  id          String    @id @default(cuid())
  savedListId String
  savedList   SavedList @relation(fields: [savedListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([savedListId, productId])
  @@index([savedListId])
  @@index([productId])
}

// ------------------------------------------------------------------------------
// AUDIT LOGS, BANNERS & STORE SETTINGS
// ------------------------------------------------------------------------------

model StoreBanner {
  id              String   @id @default(cuid())
  title           String
  subtitle        String
  ctaText         String
  ctaLink         String
  badgeText       String?
  backgroundColor String   @default("#0066CC")
  textColor       String   @default("#FFFFFF")
  imageUrl        String?
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

model HomepageBanner {
  id           String       @id @default(cuid())
  title        String
  subtitle     String?
  description  String?
  desktopImage String
  mobileImage  String?
  imageAltText String
  buttonText   String?
  buttonLink   String?
  sortOrder    Int          @default(0)
  status       BannerStatus @default(DRAFT)
  startAt      DateTime?
  endAt        DateTime?
  createdById  String?
  updatedById  String?
  createdBy    User?        @relation("BannerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("BannerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, sortOrder])
  @@index([startAt, endAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String // e.g. "INVENTORY_ADJUST", "ORDER_STATUS_UPDATE"
  entityType  String // "product", "order", "promotion", "inventory"
  entityId    String
  description String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model StoreSettings {
  id                         String   @id @default("default")
  flatDeliveryFeeCents       Int      @default(35000) // Rs. 350.00
  freeDeliveryThresholdCents Int      @default(500000) // Rs. 5,000.00
  hotlinePhone               String   @default("+94 11 200 9000")
  whatsappNumber             String   @default("+94 77 123 4567")
  contactEmail               String   @default("support@dslstationery.lk")
  codEnabled                 Boolean  @default(true)
  bankTransferEnabled        Boolean  @default(true)
  onlineCardEnabled          Boolean  @default(false)
  updatedAt                  DateTime @updatedAt
}

// ------------------------------------------------------------------------------
// SHOPPING CART & CART ITEMS
// ------------------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique // Anonymous guest cart token / session identifier
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

// ------------------------------------------------------------------------------
// BACK-IN-STOCK ALERTS (Phase 15.4)
// ------------------------------------------------------------------------------

model BackInStockAlert {
  id                  String                 @id @default(cuid())
  userId              String
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId           String
  product             Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  status              BackInStockAlertStatus @default(PENDING)
  failureReason       String?
  sentAt              DateTime?
  processingStartedAt DateTime?
  leaseExpiresAt      DateTime?
  deliveryAttempts    Int                    @default(0)
  lastAttemptAt       DateTime?
  idempotencyKey      String?
  uncertainDelivery   Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([productId, status])
  @@index([status, leaseExpiresAt])
}

// ------------------------------------------------------------------------------
// NEWSLETTER & CONSENT MANAGEMENT (Phase 15.6)
// ------------------------------------------------------------------------------

enum NewsletterSubscriberStatus {
  PENDING
  VERIFIED
  UNSUBSCRIBED
}

enum NewsletterConsentEventType {
  CONSENT_GIVEN
  EMAIL_VERIFIED
  UNSUBSCRIBED
  RESUBSCRIPTION_REQUESTED
}

model NewsletterSubscriber {
  id                 String                     @id @default(cuid())
  email              String                     @unique
  status             NewsletterSubscriberStatus @default(PENDING)
  consentGivenAt     DateTime                   @default(now())
  consentSource      String                     @default("WEBSITE_FOOTER")
  consentTextVersion String                     @default("v1.0")
  unsubscribeToken   String                     @unique @default(cuid())
  verifiedAt         DateTime?
  unsubscribedAt     DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  verificationTokens NewsletterVerificationToken[]
  consentEvents      NewsletterConsentEvent[]

  @@index([status])
  @@index([createdAt])
  @@map("newsletter_subscribers")
}

model NewsletterVerificationToken {
  id           String    @id @default(cuid())
  subscriberId String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
  @@index([expiresAt])
  @@map("newsletter_verification_tokens")
}

model NewsletterConsentEvent {
  id                 String                     @id @default(cuid())
  subscriberId       String
  eventType          NewsletterConsentEventType
  consentTextVersion String                     @default("v1.0")
  consentSource      String                     @default("WEBSITE_FOOTER")
  metadata           Json?
  createdAt          DateTime                   @default(now())

  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
  @@index([eventType])
  @@index([createdAt])
  @@map("newsletter_consent_events")
}

// ------------------------------------------------------------------------------
// ADMINISTRATOR INVITATIONS (Phase 2)
// ------------------------------------------------------------------------------

model AdminInvitation {
  id           String    @id @default(cuid())
  email        String
  tokenHash    String    @unique
  name         String
  phone        String?
  role         UserRole  @default(STAFF)
  roleId       String?
  roleRelation Role?     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  expiresAt    DateTime
  usedAt       DateTime?
  invitedById  String
  invitedBy    User      @relation("InvitedAdmins", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([tokenHash])
  @@index([invitedById])
  @@index([roleId])
  @@map("admin_invitations")
}

// ------------------------------------------------------------------------------
// ROLES & GRANULAR PERMISSIONS (Phase 3)
// ------------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
  invitations AdminInvitation[]

  @@index([slug])
  @@index([isActive])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  displayName String
  description String?
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum SkuOwnerType {
  PRODUCT
  VARIANT
}

model GlobalSku {
  sku       String          @id
  ownerType SkuOwnerType
  productId String?         @unique
  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?         @unique
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
}

model SkuSequence {
  prefix       String   @id
  lastSequence Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// ------------------------------------------------------------------------------
// PRODUCT BULK IMPORT EXECUTION (Phase 4 – Stage 4)
// ------------------------------------------------------------------------------

enum ImportStockMode {
  SET_STOCK
  ADD_STOCK
}

enum ImportBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
}

enum ImportRowStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model ProductImportPreview {
  id              String   @id @default(cuid())
  fileName        String
  fileSize        Int
  fileSha256      String
  previewChecksum String
  normalizedRows  Json
  summary         Json
  createdById     String
  createdBy       User     @relation("ImportPreviewsCreated", fields: [createdById], references: [id])
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  batches ProductImportBatch[]

  @@index([createdById])
  @@index([expiresAt])
}

model ImportExecutionLease {
  id           String   @id @default("GLOBAL_IMPORT_LEASE")
  batchId      String?
  ownerId      String?
  status       String   @default("IDLE") // IDLE, ACTIVE
  currentChunk Int      @default(0)
  heartbeatAt  DateTime @default(now())
  expiresAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductImportBatch {
  id                 String            @id @default(cuid())
  idempotencyKey     String            @unique
  adminId            String
  previewId          String
  requestFingerprint String
  stockMode          ImportStockMode   @default(SET_STOCK)
  allowUpdates       Boolean           @default(true)
  status             ImportBatchStatus @default(PENDING)
  totalRows          Int               @default(0)
  totalChunks        Int               @default(0)
  committedChunk     Int               @default(0)
  processedRows      Int               @default(0)
  successfulRows     Int               @default(0)
  failedRows         Int               @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  admin   User                     @relation("ImportBatchesCreated", fields: [adminId], references: [id])
  preview ProductImportPreview     @relation(fields: [previewId], references: [id])
  results ProductImportRowResult[]

  @@index([adminId])
  @@index([status])
  @@index([createdAt])
}

model ProductImportRowResult {
  id           String          @id @default(cuid())
  batchId      String
  rowNumber    Int
  sku          String?
  action       String
  status       ImportRowStatus
  productId    String?
  variantId    String?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime        @default(now())

  batch ProductImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, rowNumber])
  @@index([batchId, status])
}
