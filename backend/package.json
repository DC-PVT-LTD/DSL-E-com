{
  "name": "dsl-stationery-backend",
  "version": "0.1.0",
  "description": "DSL Stationery E-commerce NestJS Backend",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
